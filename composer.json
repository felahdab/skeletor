{
    "name": "fanlab/skeletor",
    "type": "project",
    "description": "Projet Skeletor: framework applicatif pour les besoins organiques de la FAN",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "alexpechkarev/geometry-library": "^1.0.5",
        "althinect/filament-spatie-roles-permissions": "*",
        "barryvdh/laravel-debugbar": "^4.4.1",
        "barryvdh/laravel-dompdf": "^3.1.2",
        "bschmitt/laravel-amqp": "^3.4.1",
        "calebporzio/sushi": "^2.5.4",
        "clickbar/laravel-magellan": "^2.2.0",
        "coolsam/modules": "^5.3.2",
        "darkaonline/l5-swagger": "^11.1.0",
        "dedoc/scramble": "^0.13.41",
        "doode/filament-map-picker": "dev-fldb-module-fleetprogram",
        "elastic/ecs-logging": "^2.0.1",
        "fakerphp/faker": "^1.24.1",
        "filament/filament": "^5.7.6",
        "filament/upgrade": "^5.7.6",
        "friendsofphp/php-cs-fixer": "^3.95.20",
        "guava/calendar": "^3.2.2",
        "guzzlehttp/guzzle": "*",
        "joshbrw/laravel-module-installer": "^2.0.1",
        "lab404/laravel-impersonate": "^1.7.8",
        "larastan/larastan": "^3.10.0",
        "laravel/dusk": "*",
        "laravel/framework": "^13.26.1",
        "laravel/sail": "^1.67.0",
        "laravel/sanctum": "^4.3.3",
        "laravel/socialite": "*",
        "laravel/tinker": "^3.0.2",
        "league/flysystem-aws-s3-v3": "^3.35.2",
        "league/flysystem-path-prefixing": "^3.31.0",
        "livewire/livewire": "^4.4.1",
        "mhmiton/laravel-modules-livewire": "^7.0.0",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "nwidart/laravel-modules": "^13.0.0",
        "owen-it/laravel-auditing": "^14.0.6",
        "parallax/filament-comments": "^3.0.0",
        "pestphp/pest": "^5.1.1",
        "pestphp/pest-plugin-faker": "^5.0.0",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-livewire": "^5.0.0",
        "php-amqplib/php-amqplib": "^3.7",
        "phpoffice/phpspreadsheet": "^5",
        "phpoffice/phpword": "^1.3",
        "phpstan/phpstan": "^2.1",
        "predis/predis": "^3.6.0",
        "saloonphp/laravel-plugin": "*",
        "saloonphp/saloon": "*",
        "socialiteproviders/keycloak": "*",
        "spatie/eloquent-sortable": "^5.0.1",
        "spatie/laravel-backup": "^10.3.1",
        "spatie/laravel-data": "^4.23.0",
        "spatie/laravel-html": "^3.13.0",
        "spatie/laravel-ignition": "^2.12.0",
        "spatie/laravel-markdown": "^2.8.0",
        "spatie/laravel-permission": "^8.3.0",
        "spatie/laravel-query-builder": "^7.3.3",
        "stancl/tenancy": "^3.10.1",
        "staudenmeir/eloquent-json-relations": "^1.14.2",
        "stechstudio/filament-impersonate": "^5.6.0",
        "valentin-morice/filament-json-column": "^4.1.0",
        "wnx/laravel-backup-restore": "^1.9.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "nwidart/laravel-modules",
                "filament/filament",
                "valentin-morice/filament-json-column",
                "guava/calendar"
            ]
        },
        "merge-plugin": {
            "include": [
                "Modules/*/composer.json"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "joshbrw/laravel-module-installer": true,
            "wikimedia/composer-merge-plugin": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/felahdab/filament-map-picker.git"
        }
    ]
}
