{
    "name": "fanlab/skeletor",
    "type": "project",
    "description": "Projet Skeletor: framework applicatif pour les besoins organiques de la FAN",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "alexpechkarev/geometry-library": "^1.0.5",
        "althinect/filament-spatie-roles-permissions": "^3.1.0",
        "barryvdh/laravel-debugbar": "^4.0.9",
        "barryvdh/laravel-dompdf": "^3.1.1",
        "calebporzio/sushi": "^2.5.3",
        "clickbar/laravel-magellan": "^2.0.1",
        "coolsam/modules": "^5.1.0",
        "darkaonline/l5-swagger": "^10.0.0",
        "dedoc/scramble": "^0.13.14",
        "doode/filament-map-picker": "dev-fldb-module-fleetprogram",
        "elastic/ecs-logging": "^2.0",
        "filament/filament": "^4.7.1",
        "guava/calendar": "^2.1.1",
        "guzzlehttp/guzzle": "^7.10.0",
        "joshbrw/laravel-module-installer": "^2.0.1",
        "lab404/laravel-impersonate": "^1.7.7",
        "laravel/framework": "^12.51.0",
        "laravel/sanctum": "^4.3.1",
        "laravel/socialite": "^5.24.2",
        "laravel/tinker": "^2.11.1",
        "league/flysystem-aws-s3-v3": "^3.0",
        "livewire/livewire": "^3.7.10",
        "mhmiton/laravel-modules-livewire": "^5.2.0",
        "nunomaduro/collision": "^8.9.0",
        "nwidart/laravel-modules": "^12.0.4",
        "owen-it/laravel-auditing": "^14.0.0",
        "parallax/filament-comments": "^2.0.0",
        "php-amqplib/php-amqplib": "^3.7",
        "phpoffice/phpspreadsheet": "^5",
        "phpoffice/phpword": "^1.3",
        "predis/predis": "^3.4.0",
        "saloonphp/laravel-plugin": "^3.8.0",
        "saloonphp/saloon": "^3.14.2",
        "socialiteproviders/keycloak": "^5.3.0",
        "spatie/eloquent-sortable": "^5.0.0",
        "spatie/laravel-backup": "^9.4.1",
        "spatie/laravel-data": "^4.19.1",
        "spatie/laravel-html": "^3.12.3",
        "spatie/laravel-markdown": "^2.7.1",
        "spatie/laravel-permission": "^6.24.1",
        "spatie/laravel-query-builder": "^6.4.1",
        "stancl/tenancy": "^3.9.1",
        "staudenmeir/eloquent-json-relations": "^1.14.1",
        "stechstudio/filament-impersonate": "^5.0.0",
        "valentin-morice/filament-json-column": "^3.0.0",
        "wnx/laravel-backup-restore": "^1.9.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24.1",
        "filament/upgrade": "^4.7.1",
        "friendsofphp/php-cs-fixer": "^3.94",
        "larastan/larastan": "^3.9.2",
        "laravel/dusk": "^8.3.6",
        "laravel/sail": "^1.53.0",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^4.3",
        "pestphp/pest-plugin-faker": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-livewire": "^4.1",
        "phpstan/phpstan": "^2.1",
        "spatie/laravel-ignition": "^2.10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "nwidart/laravel-modules",
                "filament/filament",
                "valentin-morice/filament-json-column",
                "guava/calendar"
            ]
        },
        "merge-plugin": {
            "include": [
                "Modules/*/composer.json"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "joshbrw/laravel-module-installer": true,
            "wikimedia/composer-merge-plugin": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/felahdab/filament-map-picker.git"
        }
    ]
}
