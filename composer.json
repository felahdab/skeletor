{
    "name": "fanlab/skeletor",
    "type": "project",
    "description": "Projet Skeletor: framework applicatif pour les besoins organiques de la FAN",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "alexpechkarev/geometry-library": "1.0.5",
        "althinect/filament-spatie-roles-permissions": "^2.2",
        "axonc/filament-copyable-placeholder": "^0.3.0",
        "barryvdh/laravel-debugbar": "^3.7",
        "barryvdh/laravel-dompdf": "^3.1",
        "calebporzio/sushi": "^2.4",
        "clickbar/laravel-magellan": "^2.0.0",
        "coolsam/modules": "^4",
        "darkaonline/l5-swagger": "^9.0",
        "dedoc/scramble": "^0.12.23",
        "doode/filament-map-picker": "dev-fldb-module-fleetprogram",
        "filament/filament": "^3.3.28",
        "filament/spatie-laravel-google-fonts-plugin": "^3.3.28",
        "guava/calendar": "^1.14",
        "guzzlehttp/guzzle": "^7.2",
        "joshbrw/laravel-module-installer": "^2.0",
        "lab404/laravel-impersonate": "^1.0",
        "laravel/framework": "^12.19.3",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.21.0",
        "laravel/tinker": "^2.7",
        "livewire/livewire": "^3.4",
        "mhmiton/laravel-modules-livewire": "^5",
        "nunomaduro/collision": "^8.8.2",
        "nwidart/laravel-modules": "^12.0.3",
        "owen-it/laravel-auditing": "^14.0.0",
        "parallax/filament-comments": "^1.3",
        "phpoffice/phpspreadsheet": "^4",
        "phpoffice/phpword": "^1.3",
        "predis/predis": "^3.0.1",
        "saloonphp/laravel-plugin": "^3.6.0",
        "saloonphp/saloon": "^3.14.0",
        "socialiteproviders/keycloak": "^5.2",
        "spatie/eloquent-sortable": "^4.5",
        "spatie/laravel-backup": "^9.3.3",
        "spatie/laravel-data": "^4.17.0",
        "spatie/laravel-html": "^3.2",
        "spatie/laravel-markdown": "^2.2",
        "spatie/laravel-permission": "^6.20.0",
        "spatie/laravel-query-builder": "^6.0",
        "stancl/tenancy": "^3.7",
        "staudenmeir/eloquent-json-relations": "^1.14.1",
        "stechstudio/filament-impersonate": "^3.14",
        "valentin-morice/filament-json-column": "^2.0.2",
        "wnx/laravel-backup-restore": "^1.6.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "larastan/larastan": "^3.5.0",
        "laravel/dusk": "^8.3.3",
        "laravel/sail": "^1.43.1",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^3.5",
        "pestphp/pest-plugin-faker": "^3.0",
        "pestphp/pest-plugin-laravel": "^3",
        "pestphp/pest-plugin-livewire": "^3.0",
        "phpstan/phpstan": "^2.1",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "nwidart/laravel-modules",
                "filament/filament",
                "valentin-morice/filament-json-column",
                "guava/calendar"
            ]
        },
        "merge-plugin": {
            "include": [
                "Modules/*/composer.json"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "joshbrw/laravel-module-installer": true,
            "wikimedia/composer-merge-plugin": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/felahdab/filament-map-picker.git"
        }
    ]
}
